@@ -410,33 +410,54 @@ func checkServerTime(req *http.Request, resp *http.Response) {
 }
 
-// cleanAuth gets rid of one authBuf header within the first 4k
+// cleanAuth gets rid of all authBuf headers within the header block
 func cleanAuth(buf, authBuf []byte) []byte {
-	// Find how much buffer to check
-	n := min(len(buf), 4096)
-	// See if there is an Authorization: header
-	i := bytes.Index(buf[:n], authBuf)
-	if i < 0 {
-		return buf
-	}
-	i += len(authBuf)
-	// Overwrite the next 4 chars with 'X'
-	for j := 0; i < len(buf) && j < 4; j++ {
-		if buf[i] == '\n' {
-			break
-		}
-		buf[i] = 'X'
-		i++
-	}
-	// Snip out to the next '\n'
-	j := bytes.IndexByte(buf[i:], '\n')
-	if j < 0 {
-		return buf[:i]
-	}
-	n = copy(buf[i:], buf[i+j:])
-	return buf[:i+n]
+	searchFrom := 0
+	headerEnd := bytes.Index(buf, []byte("\r\n\r\n"))
+	if headerEnd < 0 {
+		headerEnd = bytes.Index(buf, []byte("\n\n"))
+	}
+	if headerEnd < 0 {
+		headerEnd = len(buf)
+	}
+	for searchFrom < headerEnd {
+		i := bytes.Index(buf[searchFrom:headerEnd], authBuf)
+		if i < 0 {
+			return buf
+		}
+		i += searchFrom + len(authBuf)
+		// Overwrite the next 4 chars with 'X'
+		for j := 0; i < len(buf) && j < 4; j++ {
+			if buf[i] == '\n' || buf[i] == '\r' {
+				break
+			}
+			buf[i] = 'X'
+			i++
+		}
+		j := bytes.IndexByte(buf[i:], '\n')
+		if j < 0 {
+			return buf[:i]
+		}
+		lineEnd := i + j
+		if lineEnd > i && buf[lineEnd-1] == '\r' {
+			lineEnd--
+		}
+		remaining := copy(buf[i:], buf[lineEnd:])
+		buf = buf[:i+remaining]
+		headerEnd = bytes.Index(buf, []byte("\r\n\r\n"))
+		if headerEnd < 0 {
+			headerEnd = bytes.Index(buf, []byte("\n\n"))
+		}
+		if headerEnd < 0 {
+			headerEnd = len(buf)
+		}
+		searchFrom = i + 1
+	}
+	return buf
 }
 
